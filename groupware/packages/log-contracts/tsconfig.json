{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // crypto.randomUUID() 사용: 이 패키지는 Node 런타임(NestJS 서버 / SvelteKit BFF)에서만 돈다.
    // @types/node 는 devDependency 라 런타임 의존성 0 은 그대로다.
    "types": ["node"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
