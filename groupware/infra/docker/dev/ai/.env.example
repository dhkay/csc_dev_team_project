# csc-dev-ai (video-ai-server): dev-only 기본값. 그대로면 .env 없이도 기동 가능.
# 실제 값은 video-ai-server 의 infra/docker/dev/ai/.env 로 둔다(.env 는 커밋 금지).

# 서버 간 인증(Layer 3): web-server dev 스택과 동일 값이어야 토큰 검증 통과.
SERVICE_TOKEN_SECRET=dev-only-service-secret

# web-server LAN IP: worker 가 redis/file-service/video-model 에 접속할 대상.
WEB_SERVER_HOST=192.168.0.26

# 서버 모니터링 에이전트(metrics-agent) 호스트 공개 포트: control-tower(dev, pnpm)가 localhost 로 호출.
METRICS_AGENT_PORT=8090

# LLM 추론(dev): dev 는 자체 vLLM 없음. staging/ai 의 공유 csc-ai-vllm(:8010)을 함께 쓴다
# 실제 추론으로 개발하려면 web-server dev .env(dev/web)에 아래를 준다:
#   LANGUAGE_MODEL_ENGINE=vllm   (api-language-model → http://<video-ai-server>:8010/v1 = 공유 csc-ai-vllm, 14B)
# 모델/LoRA/GPU-util 등 vLLM 설정은 공유본을 소유한 staging/ai 의 .env 에서 관리한다(dev 는 설정하지 않음).
# 오프라인/로컬 실험은 dev/ai 의 ollama(host.docker.internal:11434) 또는 language-model stub(에코) 폴백 사용.
