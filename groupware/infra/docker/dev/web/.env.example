# csc-dev-web (web-server): dev-only 기본값. 그대로면 .env 없이도 기동 가능.
# 실제 값은 web-server 의 infra/docker/dev/web/.env 로 둔다(.env 는 커밋 금지).
POSTGRES_USER=csc
POSTGRES_PASSWORD=csc
POSTGRES_DB=csc_dev

# 서버 간 인증(Layer 3): dev 는 전 서버 공통 dev 시크릿. video-ai-server worker 와 동일해야 함.
SERVICE_TOKEN_SECRET=dev-only-service-secret

# web-server LAN IP: file-service 공개 베이스 URL 등에 사용(노트북/워커가 접근).
WEB_SERVER_HOST=192.168.0.26

# 업로드/결과 파일 영속 디렉토리(코드 클론 밖). 재배포와 무관하게 보존.
STORAGE_HOST_DIR=/home/csc/Storage/dev

# 서버 모니터링(server management): dev 는 단일 PC 1대(role all)라 metrics-agent 를 로컬 8090 에
#   띄운다(dev/ai compose 또는 uv 직접 실행). 주소 설정은 여기 두지 않는다: 호출자인 control-tower 가
#   dev 에서는 pnpm 으로 돌아 자기 cwd 의 .env 만 읽고, 코드 기본값이 이미 http://localhost:8090 이다.
#   다른 주소를 쓰려면 apps/api/nestjs/csc-control-tower/.env 에 METRICS_AGENT_ALL_URL 을 준다.

# 통합 로그 파이프라인 (log-server + Kafka + ClickHouse)
#   dev 는 약한 기본값. LOG_SCOPE/PROMOTED_AI_TOOLS 는 AI 도구 승격 시에만 설정한다.
CLICKHOUSE_DB=logs
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=csc
# LOG_SCOPE=platform
# PROMOTED_AI_TOOLS=
