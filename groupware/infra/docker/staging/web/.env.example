# web-server staging 환경변수 템플릿.
#
# 사용법:
#   1) 이 파일을 같은 디렉터리에 .env 로 복사:  cp .env.example .env
#   2) 아래 값을 환경에 맞게 채운다 (특히 POSTGRES_PASSWORD).
#   3) .env 는 .gitignore 로 커밋되지 않는다. 실제 비밀값은 절대 커밋 금지.
#
# 이 파일은 "키 목록 + 안전한 예시값"만 담는다. 진짜 비밀은 각 서버의 .env 에만 존재한다.
# compose 는 값이 없으면 docker-compose.yml 의 기본값(${VAR:-default})을 쓰므로,
# staging 에서 빠르게 띄울 때는 .env 없이도 동작한다(기본값으로). 운영성 비밀만 여기서 덮어쓴다.

# ─────────────────────────────────────────────────────────────
# [활성] docker-compose.yml 이 실제로 읽는 키
# ─────────────────────────────────────────────────────────────

# Postgres (web 스택 공용 DB 컨테이너)
# 논리 DB(file_upload / groupwaredb / userdb / controltowerdb)는 initdb 가 최초 1회 생성한다.
POSTGRES_USER=csc
POSTGRES_PASSWORD=change-me-staging   # ← 서버에서 강한 값으로 교체
POSTGRES_DB=csc_staging

# 서버 간 인증 (Layer 3): 전 서버(web/ai 스택) 동일 값. compose 가 필수(:?)로 요구.
SERVICE_TOKEN_SECRET=change-me-staging   # ← 강한 값으로 교체. ai 스택 .env 와 동일해야 함
# data-collector 의 외부 API 자격증명(플랫폼 키. 조직별 아님). 전부 선택.
#   실사용 수집(워커)과 /lab 검증 표면(API)이 같은 변수를 쓴다. compose 가 두 컨테이너에 함께
#   주입하므로 여기서는 한 번만 적는다.
#   미설정이면 그 소스는 호출을 건너뛰고(수집 결과 없음), /lab 은 credentials_missing 으로 답한다.
#   기동은 막지 않는다.
#   변수명은 sandbox/api-test/keys.env 와 맞춘다(실측 결과와 대조 가능해야 하므로).
#   (구 NAVER_AD_* 는 더 이상 읽지 않으므로 서버에서 제거해도 된다.)
# NAVER_TREND_CLIENT_ID=          # 검색어 트렌드 수집 + LAB-001
# NAVER_TREND_CLIENT_SECRET=
# NAVER_SHOPPING_CLIENT_ID=       # /lab 전용(쇼핑인사이트 오픈API. 스코프 미등록 상태)
# NAVER_SHOPPING_CLIENT_SECRET=
# NAVER_SEARCHAD_ACCESS_LICENSE=  # 연관 키워드/검색량 수집 + LAB-004
# NAVER_SEARCHAD_SECRET_KEY=
# NAVER_SEARCHAD_CUSTOMER_ID=
# 아래 둘은 쿼터가 좁아 크론 자동 재수집을 끈 소스다(조회가 있을 때만 모은다).
# YOUTUBE_API_KEY=                # YouTube Data API v3(sandbox keys.env 의 GOOGLE_API_KEY 와 같은 값)
# SERPAPI_API_KEY=                # SerpApi. 요금제가 월 검색 횟수를 정한다
# 조직 공용 API 자격증명(Claude 등) 암호화 키(AES-256-GCM 32바이트: `openssl rand -base64 32`). csc-groupware 등록/조회 시 필요. 고정 유지(바뀌면 기존 암호문 복호화 불가).
# GROUPWARE_SECRET_ENC_KEY=
# 서버 모니터링: control-tower 가 호출할 metrics-agent 대상. 기본값은 compose 가 제공
#   (web=metrics-agent:8000, ai=AI_SERVER_HOST:8091 / staging 은 prod 와 ai 호스트 공유 → 8091).
#   AWS/다중 확장 시 SERVER_REGISTRY_JSON 으로 레지스트리 오버라이드(선택).
# SERVER_REGISTRY_JSON=
# 허용 호출자(옵션): 미설정 시 코드 기본값 사용. compose 가 file/video-model 엔 명시 주입.
# ALLOWED_SERVICES=web-groupware,web-control-tower,csc-groupware,csc-control-tower,video-model

# Redis (arq 큐): video-ai-server worker 가 LAN 으로 접속(requirepass). compose 기본값 csc(미설정 시).
# 운영은 강한 값 권장. ai 스택 .env 의 REDIS_PASSWORD 와 동일해야 함.
REDIS_PASSWORD=change-me-staging

# JWT (user 서버 토큰 발급/검증): compose 가 필수(:?)로 요구.
JWT_SECRET=change-me-staging          # ← 강한 값으로 교체
JWT_REFRESH_SECRET=change-me-staging  # ← 강한 값으로 교체

# 플랫폼 슈퍼관리자 부트스트랩 (user 서버가 기동 시 PLATFORM 조직 ROOT 유저를 시드/갱신)
PLATFORM_ROOT_EMAIL=             # ← 필수(미설정/빈값 시 기동 거부). 운영사 실제 루트 이메일.
PLATFORM_ROOT_PASSWORD=change-me-staging  # ← 필수(미설정/빈값 시 기동 거부). 강한 값으로.

# 통합 API 문서 포털(scalar-gateway) BasicAuth: 선택(미설정 시 nginx IP allowlist 로만 보호).
# staging-api-docs.cscuniverse.com 접근 시 추가 인증(앱 레벨). CI 는 GitHub Secrets(STAGING_SWAGGER_USER/PASSWORD)로 주입.
SWAGGER_USER=apidocs                       # ← 선택. 포털 접근 계정
SWAGGER_PASSWORD=change-me-staging         # ← 선택. 강한 값으로 교체

# LLM 추론 (csc-ai-vllm): video-ai-server → web-server(유휴 5060 Ti)로 이전한 공유 vLLM
# 이 web-server 가 공유 vLLM(csc-ai-vllm, :8010)을 기동하고 dev, staging, prod 의 api-language-model 이
# host:8010(host.docker.internal)으로 함께 쓴다(단일 16GB GPU 라 14B 한 인스턴스만 상주).
# 직접 올린 가중치 마운트(HF 다운로드 아님): $AI_MODELS_DIR/qwen3-14b/ 에 config.json,*.safetensors 등.
AI_MODELS_DIR=/home/escoa/ai-models
AI_LORAS_DIR=/home/escoa/ai-loras
VLLM_MODEL=/models/qwen3-14b
# VLLM_PORT=8010                    # 호스트 게시 포트(language-model 이 host.docker.internal:이포트 로 호출)
# VLLM_GPU_UTIL=0.90                # 14B 상주(0.30≈4.6GB 부족). web-server 5060 Ti 16GB 기준.

# ─────────────────────────────────────────────────────────────
# [예정] 아직 compose/코드에 배선되지 않음. 키 형태만 참고용으로 둠.
#        실제로 쓸 때 docker-compose.yml 의 service environment 에 추가하고
#        여기 주석을 해제한다. 전체 의도된 목록은 security-architecture.md 참고.
# ─────────────────────────────────────────────────────────────

# BFF(web-groupware / web-control-tower) → 백엔드 내부 URL
#   - 같은 web 스택(동일 호스트/도커 네트워크) 서비스는 compose 서비스명으로 접근.
#     file-service, video-model 도 web 스택에 있으므로 compose 서비스명으로 호출한다.
#   - video-ai-server 의 video-model-worker 만 별도 호스트라 LAN 으로 web-server 에 접속한다(BFF 경로 아님).
#   - 서버 간 호출은 모두 서비스 토큰(X-Service-Token)을 첨부한다.
#   - 미설정 시 코드 기본값(localhost)으로 폴백 → 도커에서는 반드시 설정할 것.
# PRIVATE_API_URL=http://api-csc-groupware:3000            # csc-groupware(main)
# PRIVATE_ADMIN_API_URL=http://api-csc-control-tower:3000  # csc-control-tower(admin)
# PRIVATE_USER_API_URL=http://api-user:3000                # user(auth)
# PRIVATE_STORAGE_API_URL=http://api-file-service:8000     # file-service(업로드/스토리지)
# PRIVATE_MARKETING_API_URL=http://api-csc-marketing:3000  # csc-marketing(영상 기획안 키워드/금지어 등)

# CORS (prod/staging 은 와일드카드 금지, 명시적 Origin)
# CORS_ORIGINS=https://staging.example.com

# 오브젝트 스토리지 (file-upload: Cloudflare R2 / S3 호환)
# STORAGE_BUCKET=csc-uploads
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# 이미지 생성: 외장(OpenAI, 조직 OPENAI 키) + 내장(자체 ComfyUI FLUX.1 schnell, 무료).
#   compose 가 내장(comfyui)을 기본으로 배선한다. 아래는 오버라이드용이라 보통 비워 둔다.
#   엔진 = video-ai-server 의 공유 ComfyUI(csc-ai-comfyui, 영상 Wan 과 같은 인스턴스, prod 와 공유).
#   전제(둘 중 하나라도 빠지면 생성이 실패한다): ① 그 ComfyUI 에 FLUX.1 schnell 체크포인트 배치,
#   ② video-ai-server 8188 을 web-server(192.168.0.26)에서만 허용. 런북: infra/docker/design-image-comfyui.md
# IMAGE_ENGINE=comfyui                  # compose 기본값. stub 으로 두면 1x1 회색 placeholder 가 결과로 나간다
# IMAGE_COMFYUI_URL=                    # 기본 http://${AI_SERVER_HOST:-192.168.0.28}:8189. 호스트 이전 시에만 설정
# IMAGE_COMFYUI_TIMEOUT_S=300           # 실행 인내심(모델 로드 포함). 큐 대기는 별도(BUSY_TIMEOUT 900)
#
# 모델 선택: 영상(Wan)과 GPU 를 공유하므로 VRAM 예산이 곧 이 선택이다(실측은 런북 참고).
# IMAGE_FLUX_UNET_NAME=flux1-schnell-Q4_K_S.gguf     # 품질↑ Q5_K_S/Q6_K, 롤백 flux1-schnell-fp8.safetensors
# WAN_UNET_NAME=Wan2.2-TI2V-5B-Q6_K.gguf             # 롤백 wan2.2_ti2v_5B_fp16.safetensors (video-model)
#
# 대화형 이미지 잡을 ComfyUI 큐 앞으로(기본 true): 배치 영상 렌더 뒤에서 굶지 않게.
#   dev/staging/prod 가 같은 엔진을 공유하므로, 이 환경이 남의 렌더를 앞지르면 안 될 때 false.
# IMAGE_COMFYUI_QUEUE_FRONT=true
# 내장 엔진이 막혔을 때 외부 모델로 강등해 생성을 이어간다(기본 true). 과금 주의: 조직 외부 키로 청구된다.
#   환경 단위 스위치다. 조직/채널별로 끄는 수단은 아직 없다.
# IMAGE_EXTERNAL_FALLBACK=true

# 통합 로그 파이프라인 (log-server + Kafka + ClickHouse)
#   CLICKHOUSE_PASSWORD 는 GitHub Secrets(STAGING_CLICKHOUSE_PASSWORD) → write-secret-env 가 주입.
#   AI 도구 승격 시 LOG_SCOPE/PROMOTED_AI_TOOLS 를 설정하고 워커를 한 벌 더 띄운다.
# CLICKHOUSE_DB=logs
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# LOG_SCOPE=platform
# PROMOTED_AI_TOOLS=
