# metrics-agent 로컬 개발용 예시: 실제 배포 값은 compose env 로 주입한다.
APP_ENV=dev
SERVICE_TOKEN_SECRET=dev-only-service-secret
ALLOWED_SERVICES=csc-control-tower

# 이 에이전트가 대표하는 호스트 정체성(레지스트리 표시에 쓰임).
HOST_ID=dev-local
HOST_LABEL=Local PC
HOST_ROLE=all

# 컨테이너에서 호스트 /proc 을 마운트했을 때 그 경로(psutil 보정). 로컬 pnpm 실행 시 /proc 기본.
HOST_PROC=/proc
