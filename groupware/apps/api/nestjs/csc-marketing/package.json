{
  "name": "@csc/api-csc-marketing",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "test": "jest"
  },
  "dependencies": {
    "@csc/api-providers": "workspace:*",
    "@csc/database": "workspace:*",
    "@csc/entitlements": "workspace:*",
    "@csc/log-client": "workspace:*",
    "@csc/log-contracts": "workspace:*",
    "@csc/net-utils": "workspace:*",
    "@csc/pricing": "workspace:*",
    "@csc/tool-versions": "workspace:*",
    "@csc/video-capabilities": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@csc/saga": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFiles": [
      "reflect-metadata"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "@swc/jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
